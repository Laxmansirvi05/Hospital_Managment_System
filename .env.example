# Copy to .env.local for local work. Never commit real values.
# Full list and browser exposure rules: docs/09-security.md section 3.1.

# Server mode (server only)
NODE_ENV=development # Select development, test or production behavior.
PORT=4000 # Local HTTP port; defaults to 4000.
TRUST_PROXY=false # Set true only behind a proxy that overwrites forwarding headers.
VERCEL=0 # Vercel sets this to 1; keep zero for local work.
VERCEL_ENV=development # Vercel sets production or preview on deployed environments.

# Database (server only)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
# D-60 production listing import only; keep the owner's restricted URL in .env.local.
PROD_IMPORT_DATABASE_URL=replace-me

# Auth (server only). At least 32 random characters each.
JWT_SECRET=replace-with-at-least-32-random-characters
TRACKING_TOKEN_PEPPER=replace-with-at-least-32-random-characters
# D-21: "true" only in local and preview. Production leaves it unset (patients only).
ALLOW_PRIVILEGED_SIGNUP=false

# Supabase Storage (server only). The service role key bypasses Row Level Security.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Public by design. Returned to the browser by GET /api/v1/config and nothing else.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=replace-me
PUBLIC_MAPTILER_KEY=replace-me


# Triage models (server only). Groq, then optional OpenRouter fallbacks.
GROQ_API_KEY=replace-me
OPENROUTER_API_KEY=replace-me
# Groq model name; defaults to openai/gpt-oss-120b.
GROQ_MODEL=openai/gpt-oss-120b
# Whole-site daily cap for assistant provider calls; defaults to 300.
ASSISTANT_DAILY_LIMIT=300
# Optional OpenRouter models, tried in order; every model must be free (D-66).
OPENROUTER_MODELS=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free

# Routing (server only; optional. Missing key uses an estimated straight-line ETA.)
MAPBOX_TOKEN=replace-with-mapbox-server-token

# SMS (server only; optional. Trial sends only to verified numbers.)
TWILIO_ACCOUNT_SID=replace-with-account-sid
TWILIO_AUTH_TOKEN=replace-with-auth-token
TWILIO_FROM=+15555550100
