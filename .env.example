# Copy to .env.local for local work. Never commit real values.
# Full list and browser exposure rules: docs/09-security.md section 3.1.

# Database (server only)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Auth (server only). At least 32 random characters each.
JWT_SECRET=replace-with-at-least-32-random-characters
TRACKING_TOKEN_PEPPER=replace-with-at-least-32-random-characters

# Supabase Storage (server only). The service role key bypasses Row Level Security.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Public by design. Returned to the browser by GET /api/v1/config and nothing else.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=replace-me
PUBLIC_MAPTILER_KEY=replace-me

# Triage models (server only). Order: Gemini, Groq, OpenRouter.
GEMINI_API_KEY=replace-me
GROQ_API_KEY=replace-me
OPENROUTER_API_KEY=replace-me

# Routing (server only)
MAPBOX_SECRET_TOKEN=replace-me

# SMS (server only). Twilio trial sends only to verified numbers.
TWILIO_ACCOUNT_SID=replace-me
TWILIO_API_KEY_SID=replace-me
TWILIO_API_KEY_SECRET=replace-me
TWILIO_FROM_NUMBER=replace-me
