{
  "name": "careroute",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "CareRoute: connects the patient, the ambulance, the hospital and medical reports during an emergency.",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.js",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "node scripts/lint-style.js && node scripts/scan-public.js",
    "check:env": "node --env-file-if-exists=.env.local scripts/check-env.js",
    "verify": "pnpm lint && pnpm check && pnpm test",
    "test:db": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run tests/db.test.js",
    "db:start": "supabase start -x studio,imgproxy,logflare,vector,edge-runtime,mailpit,postgres-meta,supavisor,gotrue,postgrest",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset"
  },
  "dependencies": {
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "supabase": "2.121.0",
    "vitest": "5.0.5"
  }
}
